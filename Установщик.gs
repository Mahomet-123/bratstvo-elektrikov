"from\": false, \"price\": 1.5}, {\"section\": \"Коэффициенты и особые условия\", \"n\": 200, \"name\": \"Работы, выполняющиеся на высоте от 5 до 7 м\", \"unit\": \"коэф.\", \"from\": false, \"price\": 2}, {\"section\": \"Коэффициенты и особые условия\", \"n\": 201, \"name\": \"Работы, выполняющиеся под напряжением\", \"unit\": \"коэф.\", \"from\": false, \"price\": 2}, {\"section\": \"Коэффициенты и особые условия\", \"n\": 202, \"name\": \"Работы с дорогостоящими приборами и оборудованием\", \"unit\": \"коэф.\", \"from\": false, \"price\": 2}, {\"section\": \"Коэффициенты и особые условия\", \"n\": 203, \"name\": \"Снабжение материалом от стоимости материала, но не менее 1500 руб.\", \"unit\": \"%\", \"from\": false, \"price\": 10}, {\"section\": \"Коэффициенты и особые условия\", \"n\": 204, \"name\": \"Пусконаладочные работы от стоимости оборудования\", \"unit\": \"%\", \"from\": false, \"price\": 30}, {\"section\": \"Примечания\", \"n\": 205, \"name\": \"Электрик убирает за собой мусор после выполнения работ\", \"unit\": \"\", \"from\": false, \"price\": 0}, {\"section\": \"Примечания\", \"n\": 206, \"name\": \"Запрещено принимать или требовать деньги на обед\", \"unit\": \"\", \"from\": false, \"price\": 0}]';" },
  { name: 'Sheets', source: "/**\n * ============================================\n * Модуль: Sheets\n * Ответственность: Единая работа с листами: создание структуры, чтение таблиц, поиск строк\n * Зависимости: Config\n * ============================================\n */\n\nconst Sheets = (() => {\n\n  let ss = null;\n\n  /** Открытая рабочая таблица (открывается лениво, кэшируется на выполнение). */\n  function service(name) {\n    if (!ss) ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);\n    return ss.getSheetByName(name);\n  }\n\n  function serviceByName(name) {\n    if (!ss) ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);\n    return ss.getSheetByName(name);\n  }\n\n  function requireSheet(name) {\n    const sheet = service(name);\n    if (!sheet) throw new Error('Лист не найден: ' + name);\n    return sheet;\n  }\n\n  /** Заголовки листа (первая строка). */\n  function headers(sheet) {\n    if (sheet.getLastColumn() < 1) return [];\n    return sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(String);\n  }\n\n  /** Лист как массив объектов по заголовкам. Пустые строки пропускаются. */\n  function table(sheet) {\n    const h = headers(sheet);\n    const rows = sheet.getLastRow() > 1\n      ? sheet.getRange(2, 1, sheet.getLastRow() - 1, h.length).getValues()\n      : [];\n    return rows\n      .map(cols => {\n        const obj = {};\n        h.forEach((key, i) => { obj[key] = cols[i]; });\n        return obj;\n      })\n      .filter(row => h.some(key => String(row[key] || '').length));\n  }\n\n  /** Добавить строку объектом (ключи = заголовки). Возвращает номер строки. */\n  function appendRow(sheetName, obj) {\n    const sheet = requireSheet(sheetName);\n    const h = headers(sheet);\n    const values = h.map(key => obj[key] !== undefined ? obj[key] : '');\n    sheet.appendRow(values);\n    return sheet.getLastRow();\n  }\n\n  /** Номер строки (1-based) по точному совпадению значения в колонке, или -1. */\n  function findRow(sheet, h, headerName, value) {\n    const col = h.indexOf(headerName);\n    if (col < 0 || sheet.getLastRow() < 2) return -1;\n    const column = sheet.getRange(2, col + 1, sheet.getLastRow() - 1, 1).getValues();\n    for (let i = 0; i < column.length; i++) {\n      if (String(column[i][0]) === String(value)) return i + 2;\n    }\n    return -1;\n  }\n\n  /**\n   * Создать служебные листы, если их нет, и проставить заголовки.\n   * Вызывается из «Инициализация» в меню таблицы.\n   */\n  function ensureStructure() {\n    if (!ss) ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);\n    ensureSheet(CONFIG.SHEETS.OBJECTS, [\n      'ID', 'Номер', 'Имя', 'Имя листа', 'Клиент', 'Адрес', 'Телефон',\n      'Статус', 'Токен кабинета', 'Создан', 'Закрыт',\n    ]);\n    ensureSheet(CONFIG.SHEETS.PRICES, ['Раздел', 'Номер', 'Позиция', 'Единица', 'Цена', 'От', 'Источник']);\n    ensureSheet(CONFIG.SHEETS.USERS, [\n      'Логин', 'Имя', 'Код доступа', 'Роль', 'Статус', 'Создан',\n      'Последний вход', 'Токен сессии', 'Токен до',\n    ]);\n    ensureSheet(CONFIG.SHEETS.VISITS, ['Дата', 'Логин', 'Действие', 'Устройство']);\n    ensureSheet(CONFIG.SHEETS.STATUSES, ['Дата', 'Логин', 'Не отправлено', 'Комментарий']);\n  }\n\n  function ensureSheet(name, headerRow) {\n    let sheet = ss.getSheetByName(name);\n    if (!sheet) sheet = ss.insertSheet(name);\n    if (sheet.getLastRow() < 1) {\n      sheet.appendRow(headerRow);\n      sheet.getRange(1, 1, 1, headerRow.length).setFontWeight('bold');\n      sheet.setFrozenRows(1);\n    }\n    return sheet;\n  }\n\n  /** Допустимое и уникальное имя листа под объект. */\n  function uniqueTabName(desired) {\n    const existing = new Set(ss.getSheets().map(s => s.getName()));\n    if (!existing.has(desired)) return desired;\n    let i = 2;\n    while (existing.has(desired + ' (' + i + ')')) i++;\n    return desired + ' (' + i + ')';\n  }\n\n  return { service, serviceByName, requireSheet, headers, table, appendRow, findRow, ensureStructure, uniqueTabName };\n})();" },
  { name: 'Users', source: "/**\n * ============================================\n * Модуль: Users\n * Ответственность: Вход по логину и коду, выдача и отзыв кодов, роли, журнал посещений\n * Зависимости: Config, Sheets\n * ============================================\n */\n\nconst Users = (() => {\n\n  /** Читает лист «Пользователи» как массив объектов. */\n  function all() {\n    const sheet = Sheets.service(CONFIG.SHEETS.USERS);\n    if (!sheet.getLastRow()) return [];\n    const rows = Sheets.table(sheet);\n    return rows.map(r => ({\n      login: String(r['Логин'] || ''),\n      name: String(r['Имя'] || ''),\n      code: String(r['Код доступа'] || ''),\n      role: String(r['Роль'] || ''),           // «руководитель» или «мастер»\n      active: String(r['Статус'] || '') === 'активен',\n      created: String(r['Создан'] || ''),\n      lastVisit: String(r['Последний вход'] || ''),\n      token: String(r['Токен сессии'] || ''),\n      tokenUntil: String(r['Токен до'] || ''),\n    })).filter(u => u.login);\n  }\n\n  function byLogin(login) {\n    const key = String(login || '').trim().toLowerCase();\n    return all().find(u => u.login.toLowerCase() === key) || null;\n  }\n\n  /**\n   * Вход по логину и коду. При успехе: выдаётся токен сессии, пишется запись в «Посещения».\n   * @param {string} login\n   * @param {string} code\n   * @param {string} device — краткое описание устройства из User-Agent\n   * @returns {{ok: boolean, error?: string, user?: object, token?: string}}\n   */\n  function login(login, code, device) {\n    const user = byLogin(login);\n    if (!user) return { ok: false, error: 'Такого логина нет' };\n    if (!user.active) return { ok: false, error: 'Профиль не активирован руководителем' };\n    if (user.code !== String(code || '')) return { ok: false, error: 'Неверный код доступа' };\n\n    const token = Utilities.getUuid();\n    const until = new Date(Date.now() + CONFIG.SESSION_DAYS * 86400000);\n    updateRow(user.login, {\n      'Токен сессии': token,\n      'Токен до': until.toISOString(),\n      'Последний вход': new Date().toISOString(),\n    });\n    Visits.log(login, 'вход', device);\n    return { ok: true, user: publicUser(user), token };\n  }\n\n  /** Проверка токена сессии. Возвращает пользователя или null. */\n  function byToken(token) {\n    if (!token) return null;\n    const user = all().find(u => u.token && u.token === token);\n    if (!user) return null;\n    if (!user.tokenUntil || new Date(user.tokenUntil) < new Date()) return null;\n    return user;\n  }\n\n  /** Список активных логинов для экрана входа. */\n  function loginOptions() {\n    return all()\n      .filter(u => u.active)\n      .map(u => ({ login: u.login, name: u.name, role: u.role }));\n  }\n\n  /**\n   * Создать или обновить профиль (только руководитель).\n   * Активация слота «мастер N» — Руководитель задаёт имя и код доступа.\n   */\n  function save(actor, data) {\n    requireRole(actor, 'руководитель');\n    const login = String(data.login || '').trim();\n    if (!login) throw new Error('Логин обязателен');\n    const patch = {\n      'Имя': String(data.name || login),\n      'Код доступа': String(data.code || ''),\n      'Роль': String(data.role || 'мастер'),\n      'Статус': data.active ? 'активен' : 'ожидает',\n    };\n    const existing = byLogin(login);\n    if (existing) {\n      updateRow(login, patch);\n    } else {\n      patch['Логин'] = login;\n      patch['Создан'] = new Date().toISOString();\n      Sheets.appendRow(CONFIG.SHEETS.USERS, patch);\n    }\n    return { ok: true };\n  }\n\n  /** Сменить собственный код доступа. */\n  function changeOwnCode(actor, oldCode, newCode) {\n    if (!actor) throw new Error('Нужен вход');\n    if (actor.code !== String(oldCode || '')) throw new Error('Старый код неверный');\n    if (String(newCode || '').length < 4) throw new Error('Код — минимум 4 символа');\n    updateRow(actor.login, { 'Код доступа': String(newCode) });\n    return { ok: true };\n  }\n\n  /**\n   * Первичное наполнение листа «Пользователи»: Руководитель + слоты мастер 1…50.\n   * Коды доступа Руководитель задаёт позже через save() — слот активируется.\n   */\n  function seedSlots() {\n    Sheets.ensureStructure();\n    if (all().length) return { ok: true, skipped: true };\n    Sheets.appendRow(CONFIG.SHEETS.USERS, {\n      'Логин': 'Руководитель',\n      'Имя': 'Руководитель',\n      'Код доступа': '0000', // сменить при первом входе\n      'Роль': 'руководитель',\n      'Статус': 'активен',\n      'Создан': new Date().toISOString(),\n    });\n    for (let i = 1; i <= 50; i++) {\n      Sheets.appendRow(CONFIG.SHEETS.USERS, {\n        'Логин': 'мастер ' + i,\n        'Имя': 'мастер ' + i,\n        'Код доступа': '',\n        'Роль': 'мастер',\n        'Статус': 'ожидает',\n        'Создан': new Date().toISOString(),\n      });\n    }\n    return { ok: true, created: 51 };\n  }\n\n  function requireRole(actor, role) {\n    if (!actor || actor.role !== role) throw new Error('Недостаточно прав');\n  }\n\n  function updateRow(login, patch) {\n    const sheet = Sheets.service(CONFIG.SHEETS.USERS);\n    const headers = Sheets.headers(sheet);\n    const rowIndex = Sheets.findRow(sheet, headers, 'Логин', login);\n    if (rowIndex < 0) throw new Error('Профиль не найден: ' + login);\n    headers.forEach(h => {\n      if (patch[h] !== undefined) {\n        sheet.getRange(rowIndex, headers.indexOf(h) + 1).setValue(patch[h]);\n      }\n    });\n  }\n\n  function publicUser(u) {\n    return { login: u.login, name: u.name, role: u.role, active: u.active };\n  }\n\n  return { all, byLogin, byToken, loginOptions, login, save, changeOwnCode, seedSlots };\n})();" },
  { name: 'Visits', source: "/**\n * ============================================\n * Модуль: Visits\n * Ответственность: Журнал посещений и снимки очереди отправки — для панели руководителя\n * Зависимости: Config, Sheets\n * ============================================\n */\n\nconst Visits = (() => {\n\n  /** Записать событие (вход/выход/открытие приложения). */\n  function log(login, action, device) {\n    Sheets.appendRow(CONFIG.SHEETS.VISITS, {\n      'Дата': new Date().toISOString(),\n      'Логин': login,\n      'Действие': action,\n      'Устройство': shorten(device),\n    });\n  }\n\n  /** Снимок состояния очереди с устройства мастера. */\n  function reportStatus(login, pending, comment) {\n    Sheets.appendRow(CONFIG.SHEETS.STATUSES, {\n      'Дата': new Date().toISOString(),\n      'Логин': login,\n      'Не отправлено': Number(pending) || 0,\n      'Комментарий': comment || '',\n    });\n  }\n\n  /** Последние события посещений (для панели руководителя). */\n  function recent(limit) {\n    const rows = Sheets.table(Sheets.requireSheet(CONFIG.SHEETS.VISITS));\n    return rows.slice(-Math.min(limit || 100, 500)).reverse();\n  }\n\n  /** Последний снимок очереди по каждому мастеру — для панели руководителя. */\n  function latestStatuses() {\n    const rows = Sheets.table(Sheets.requireSheet(CONFIG.SHEETS.STATUSES));\n    const byUser = {};\n    rows.forEach(r => {\n      byUser[String(r['Логин'] || '')] = {\n        date: String(r['Дата'] || ''),\n        pending: Number(r['Не отправлено']) || 0,\n      };\n    });\n    return byUser;\n  }\n\n  function shorten(text) {\n    const s = String(text || '');\n    return s.length > 80 ? s.slice(0, 80) : s;\n  }\n\n  return { log, reportStatus, recent, latestStatuses };\n})();" },
  { name: 'Objects', source: "/**\n * ============================================\n * Модуль: Objects\n * Ответственность: Реестр объектов, лист под каждый объект «NNN_Имя», статусы, архив\n * Зависимости: Config, Sheets, Archive\n * ============================================\n */\n\nconst Objects = (() => {\n\n  /** Колонки листа объекта — едины для блоков РАСЧЁТ / ДЕНЬ / ЗАКУПКА. */\n  const TAB_HEADERS = [\n    'Тип', 'Дата', 'Исполнитель', 'Описание', 'Единица', 'Кол-во',\n    'Коэффициент', 'Цена', 'Сумма', 'Комментарий', 'Фото', 'ID записи', 'Пометки',\n  ];\n\n  function all() {\n    return Sheets.table(Sheets.requireSheet(CONFIG.SHEETS.OBJECTS)).map(normalize);\n  }\n\n  function byId(id) {\n    return all().find(o => o.id === String(id)) || null;\n  }\n\n  /** Создать объект: заводит лист «NNN_Имя» и строку в реестре. */\n  function create(data) {\n    const name = String(data.name || '').trim();\n    if (!name) throw new Error('Имя объекта обязательно');\n    const count = all().length;\n    const number = String(count + 1).padStart(3, '0');\n    const tabName = Sheets.uniqueTabName(number + '_' + sanitize(name));\n    const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);\n    const sheet = ss.insertSheet(tabName);\n    sheet.appendRow(TAB_HEADERS);\n    sheet.getRange(1, 1, 1, TAB_HEADERS.length).setFontWeight('bold');\n    sheet.setFrozenRows(1);\n    const id = Utilities.getUuid();\n    Sheets.appendRow(CONFIG.SHEETS.OBJECTS, {\n      'ID': id,\n      'Номер': number,\n      'Имя': name,\n      'Имя листа': tabName,\n      'Клиент': String(data.client || ''),\n      'Адрес': String(data.address || ''),\n      'Телефон': String(data.phone || ''),\n      'Статус': 'в работе',\n      'Токен кабинета': makeToken(),\n      'Создан': new Date().toISOString(),\n      'Закрыт': '',\n    });\n    return { ok: true, id };\n  }\n\n  /** Изменить поля объекта в реестре. */\n  function update(id, patch) {\n    const sheet = Sheets.requireSheet(CONFIG.SHEETS.OBJECTS);\n    const h = Sheets.headers(sheet);\n    const row = Sheets.findRow(sheet, h, 'ID', id);\n    if (row < 0) throw new Error('Объект не найден');\n    h.forEach(key => {\n      if (patch[key] !== undefined) sheet.getRange(row, h.indexOf(key) + 1).setValue(patch[key]);\n    });\n    return { ok: true };\n  }\n\n  /** Закрыть объект: копия листа уходит в архив, из рабочей таблицы лист убирается. */\n  function close(id) {\n    const obj = byId(id);\n    if (!obj) throw new Error('Объект не найден');\n    if (obj.status === 'закрыт') return { ok: true };\n    Archive.store(obj);\n    SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)\n      .deleteSheet(Sheets.serviceByName(obj.tabName));\n    update(id, { 'Статус': 'закрыт', 'Закрыт': new Date().toISOString() });\n    return { ok: true };\n  }\n\n  /** Возобновление работ по закрытому объекту: лист возвращается из архива с историей. */\n  function resume(id) {\n    const obj = byId(id);\n    if (!obj) throw new Error('Объект не найден');\n    if (obj.status !== 'закрыт') return { ok: true };\n    Archive.restore(obj);\n    update(id, { 'Статус': 'в работе' });\n    return { ok: true };\n  }\n\n  function normalize(o) {\n    return {\n      id: String(o.ID || ''),\n      number: String(o['Номер'] || ''),\n      name: String(o['Имя'] || ''),\n      tabName: String(o['Имя листа'] || ''),\n      client: String(o['Клиент'] || ''),\n      address: String(o['Адрес'] || ''),\n      phone: String(o['Телефон'] || ''),\n      status: String(o['Статус'] || ''),\n      token: String(o['Токен кабинета'] || ''),\n      created: String(o['Создан'] || ''),\n      closed: String(o['Закрыт'] || ''),\n      // Год закрытия задаёт, в какую таблицу-архив уезжает объект\n      closedYear: String(o['Закрыт'] || '').slice(0, 4) || String(new Date().getFullYear()),\n    };\n  }\n\n  function sanitize(name) {\n    return name\n      .replace(/[\\\\\\/\\?\\*\\[\\]:]/g, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim()\n      .slice(0, CONFIG.OBJECT_NAME_IN_TAB);\n  }\n\n  function makeToken() {\n    const chars = 'abcdefghjkmnpqrstuvwxyz23456789';\n    let out = '';\n    for (let i = 0; i < CONFIG.TOKEN_LENGTH; i++) {\n      out += chars.charAt(Math.floor(Math.random() * chars.length));\n    }\n    return out;\n  }\n\n  return { TAB_HEADERS, all, byId, create, update, close, resume, sanitize };\n})();" },
  { name: 'Records', source: "/**\n * ============================================\n * Модуль: Records\n * Ответственность: Записи внутри листа объекта: расчёт, дни, закупки. Идемпотентность и пометка дублей\n * Зависимости: Config, Sheets, Objects\n * ============================================\n */\n\nconst Records = (() => {\n\n  /**\n   * Добавить пачку записей в лист объекта.\n   * Каждая запись несёт свой ID с устройства — повторная отправка дублем не считается.\n   * @param {string} objectId\n   * @param {Array} items — [{id, type, date, user, name, unit, qty, coef, price, sum, comment, photoIds, flags}]\n   */\n  function appendBatch(objectId, items) {\n    const obj = Objects.byId(objectId);\n    if (!obj) throw new Error('Объект не найден');\n    const sheet = Sheets.serviceByName(obj.tabName);\n    const h = Objects.TAB_HEADERS;\n\n    const existingIds = readColumn(sheet, h, 'ID записи');\n    const dayKeys = readColumn(sheet, h, 'Дата').map((date, i) => date);\n    const typeCol = readColumn(sheet, h, 'Тип');\n    const userCol = readColumn(sheet, h, 'Исполнитель');\n\n    const appended = [];\n    const duplicates = [];\n    items.forEach(item => {\n      if (existingIds.indexOf(String(item.id)) >= 0) {\n        duplicates.push(item.id);\n        return;\n      }\n      // Свободная запись с пометкой: день с двух телефонов — не блокируем, а помечаем\n      let flags = String(item.flags || '');\n      if (item.type === 'ДЕНЬ') {\n        const sameDay = dayKeys.some((d, i) =>\n          String(d).slice(0, 10) === String(item.date).slice(0, 10) &&\n          typeCol[i] === 'ДЕНЬ' && userCol[i] === String(item.user));\n        if (sameDay) flags = appendFlag(flags, 'возможный дубль');\n      }\n      sheet.appendRow([\n        item.type || '', String(item.date || ''), String(item.user || ''),\n        String(item.name || ''), String(item.unit || ''), Number(item.qty) || 0,\n        Number(item.coef) || 1, Number(item.price) || 0, Number(item.sum) || 0,\n        String(item.comment || ''), String(item.photoIds || ''), String(item.id || ''),\n        flags,\n      ]);\n      existingIds.push(String(item.id));\n      appended.push(item.id);\n    });\n\n    return { ok: true, appended, duplicates };\n  }\n\n  /** Все записи объекта (для карточки, отчёта, кабинета клиента). */\n  function list(objectId) {\n    const obj = Objects.byId(objectId);\n    if (!obj) throw new Error('Объект не найден');\n    if (obj.status === 'закрыт') {\n      return Archive.readRecords(obj);\n    }\n    const sheet = Sheets.serviceByName(obj.tabName);\n    if (!sheet) return [];\n    return Sheets.table(sheet).map(row => ({\n      type: String(row['Тип'] || ''),\n      date: String(row['Дата'] || ''),\n      user: String(row['Исполнитель'] || ''),\n      name: String(row['Описание'] || ''),\n      unit: String(row['Единица'] || ''),\n      qty: Number(row['Кол-во']) || 0,\n      coef: Number(row['Коэффициент']) || 1,\n      price: Number(row['Цена']) || 0,\n      sum: Number(row['Сумма']) || 0,\n      comment: String(row['Комментарий'] || ''),\n      photoIds: String(row['Фото'] || ''),\n      id: String(row['ID записи'] || ''),\n      flags: String(row['Пометки'] || ''),\n    }));\n  }\n\n  /**\n   * Сводка «кто что записал за дату» — для панели руководителя.\n   * Сканирует листы объектов в работе (ленивая выгрузка: только открытые объекты).\n   * @param {string} date — YYYY-MM-DD\n   * @returns {Array} [{objectId, name, perUser: [{user, records, hours}]}]\n   */\n  function daySummary(date) {\n    const target = String(date || today());\n    return Objects.all()\n      .filter(o => o.status !== 'закрыт')\n      .map(obj => {\n        let records;\n        try {\n          records = list(obj.id);\n        } catch (e) {\n          return { objectId: obj.id, name: obj.name, perUser: [] };\n        }\n        const perUser = {};\n        records.forEach(r => {\n          if (String(r.date).slice(0, 10) !== target) return;\n          if (!perUser[r.user]) perUser[r.user] = { user: r.user, records: 0, hours: 0 };\n          perUser[r.user].records += 1;\n          if (r.type === 'ДЕНЬ') perUser[r.user].hours += Number(r.qty) || 0;\n        });\n        return {\n          objectId: obj.id,\n          name: obj.name,\n          perUser: Object.keys(perUser).map(k => perUser[k]),\n        };\n      });\n  }\n\n  /** Последняя дата записи по каждому объекту — для индикатора «дней без записи». */\n  function lastRecordDates() {\n    const out = {};\n    Objects.all().forEach(obj => {\n      if (obj.status === 'закрыт') { out[obj.id] = ''; return; }\n      let records = [];\n      try { records = list(obj.id); } catch (e) { records = []; }\n      out[obj.id] = records.length ? records[records.length - 1].date.slice(0, 10) : '';\n    });\n    return out;\n  }\n\n  function readColumn(sheet, h, header) {\n    const col = h.indexOf(header);\n    if (col < 0 || sheet.getLastRow() < 2) return [];\n    return sheet.getRange(2, col + 1, sheet.getLastRow() - 1, 1).getValues().map(v => String(v[0]));\n  }\n\n  function appendFlag(flags, flag) {\n    if (!flags) return flag;\n    return flags.indexOf(flag) >= 0 ? flags : flags + ', ' + flag;\n  }\n\n  function today() {\n    return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');\n  }\n\n  return { appendBatch, list, daySummary, lastRecordDates };\n})();" },
  { name: 'Prices', source: "/**\n * ============================================\n * Модуль: Prices\n * Ответственность: Справочник работ: чтение для калькулятора и перезаливка из нового PDF\n * Зависимости: Config, Sheets\n * ============================================\n */\n\nconst Prices = (() => {\n\n  /** Весь прайс, сгруппированный по разделам. */\n  function all() {\n    const rows = Sheets.table(Sheets.requireSheet(CONFIG.SHEETS.PRICES));\n    const sections = {};\n    rows.forEach(r => {\n      const section = String(r['Раздел'] || 'Без раздела');\n      if (!sections[section]) sections[section] = [];\n      sections[section].push({\n        n: Number(r['Номер']) || 0,\n        name: String(r['Позиция'] || ''),\n        unit: String(r['Единица'] || ''),\n        price: Number(r['Цена']) || 0,\n        from: String(r['От'] || '') === 'да',\n        source: String(r['Источник'] || ''),\n      });\n    });\n    return { sections };\n  }\n\n  /**\n   * Перезаливка прайса из нового PDF (присылает руководитель — я обновляю seed).\n   * Старые цены не удаляются: меняется поле «Активен», история сохраняется в «Источник».\n   * @param {Array} items — [{section, n, name, unit, price, from}]\n   */\n  function replace(items) {\n    if (!Array.isArray(items) || !items.length) throw new Error('Список позиций пуст');\n    const sheet = Sheets.requireSheet(CONFIG.SHEETS.PRICES);\n    const h = Sheets.headers(sheet);\n    const now = new Date().toISOString();\n    items.forEach(item => {\n      sheet.appendRow([\n        item.section, item.n, item.name, item.unit,\n        item.price, item.from ? 'да' : '', 'загружено ' + now.slice(0, 10),\n      ]);\n    });\n    SpreadsheetApp.flush();\n    return { ok: true, count: items.length };\n  }\n\n  return { all, replace };\n})();" },
  { name: 'Photos', source: "/**\n * ============================================\n * Модуль: Photos\n * Ответственность: Загрузка фото накладных (WebP) в Google Drive, папка на каждый объект\n * Зависимости: Config, Sheets, Objects\n * ============================================\n */\n\nconst Photos = (() => {\n\n  /**\n   * Загрузить одно фото base64 (WebP/JPEG) в папку объекта.\n   * @param {string} objectId\n   * @param {string} base64 — содержимое файла в base64\n   * @param {string} mime — 'image/webp' или 'image/jpeg'\n   * @returns {{ok: boolean, fileId?: string}}\n   */\n  function upload(objectId, base64, mime) {\n    const obj = Objects.byId(objectId);\n    if (!obj) throw new Error('Объект не найден');\n    if (!base64) throw new Error('Пустые данные фото');\n    const ext = mime === 'image/webp' ? 'webp' : 'jpg';\n    const folder = ensureObjectFolder(obj.tabName);\n    const blob = Utilities.newBlob(Utilities.base64Decode(base64), mime || 'image/webp',\n      'накладная_' + new Date().getTime() + '.' + ext);\n    const file = folder.createFile(blob);\n    return { ok: true, fileId: file.getId() };\n  }\n\n  /** Прямая ссылка для просмотра/скачивания по идентификатору файла. */\n  function url(fileId) {\n    return 'https://drive.google.com/uc?export=view&id=' + fileId;\n  }\n\n  function ensureObjectFolder(tabName) {\n    const root = ensureFolder(CONFIG.DRIVE_ROOT_FOLDER);\n    const it = root.getFoldersByName(tabName);\n    return it.hasNext() ? it.next() : root.createFolder(tabName);\n  }\n\n  function ensureFolder(name) {\n    const it = DriveApp.getFoldersByName(name);\n    return it.hasNext() ? it.next() : DriveApp.createFolder(name);\n  }\n\n  return { upload, url };\n})();" },
  { name: 'Archive', source: "/**\n * ============================================\n * Модуль: Archive\n * Ответственность: Хранение закрытых объектов: копия листа в годовую таблицу-архив и возврат\n * Зависимости: Config, Sheets, Objects\n * ============================================\n */\n\nconst Archive = (() => {\n\n  /** Скопировать лист объекта в архив года и удалить из рабочей таблицы. */\n  function store(obj) {\n    const archive = openOrCreateArchive(obj.closedYear());\n    const source = Sheets.serviceByName(obj.tabName);\n    if (!source) throw new Error('Лист объекта не найден: ' + obj.tabName);\n    source.copyTo(archive).setName(obj.tabName);\n    logToArchive(archive, obj, 'закрыт');\n  }\n\n  /** Вернуть лист объекта из архива в рабочую таблицу (с историей). */\n  function restore(obj) {\n    const archive = findArchive(obj.closedYear());\n    const source = archive ? archive.getSheetByName(obj.tabName) : null;\n    if (!source) throw new Error('В архиве нет листа: ' + obj.tabName);\n    source.copyTo(SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID)).setName(obj.tabName);\n  }\n\n  /** Прочитать записи закрытого объекта прямо из архива. */\n  function readRecords(obj) {\n    const archive = findArchive(obj.closedYear());\n    const sheet = archive ? archive.getSheetByName(obj.tabName) : null;\n    if (!sheet) return [];\n    return Sheets.table(sheet).map(row => ({\n      type: String(row['Тип'] || ''),\n      date: String(row['Дата'] || ''),\n      user: String(row['Исполнитель'] || ''),\n      name: String(row['Описание'] || ''),\n      unit: String(row['Единица'] || ''),\n      qty: Number(row['Кол-во']) || 0,\n      coef: Number(row['Коэффициент']) || 1,\n      price: Number(row['Цена']) || 0,\n      sum: Number(row['Сумма']) || 0,\n      comment: String(row['Комментарий'] || ''),\n      photoIds: String(row['Фото'] || ''),\n      id: String(row['ID записи'] || ''),\n      flags: String(row['Пометки'] || ''),\n    }));\n  }\n\n  function openOrCreateArchive(year) {\n    const existing = findArchive(year);\n    if (existing) return existing;\n    const folder = ensureFolder(CONFIG.ARCHIVE_FOLDER);\n    const ss = SpreadsheetApp.create(CONFIG.ARCHIVE_PREFIX + ' ' + year);\n    const file = DriveApp.getFileById(ss.getId());\n    folder.addFile(file);\n    DriveApp.getRootFolder().removeFile(file);\n    return ss;\n  }\n\n  function findArchive(year) {\n    const folder = DriveApp.getFoldersByName(CONFIG.ARCHIVE_FOLDER);\n    if (!folder.hasNext()) return null;\n    const files = folder.next().getFilesByName(CONFIG.ARCHIVE_PREFIX + ' ' + year);\n    return files.hasNext() ? SpreadsheetApp.openById(files.next().getId()) : null;\n  }\n\n  function logToArchive(archive, obj, action) {\n    let sheet = archive.getSheetByName('Реестр');\n    if (!sheet) {\n      sheet = archive.insertSheet('Реестр');\n      sheet.appendRow(['ID', 'Имя листа', 'Клиент', 'Действие', 'Дата']);\n    }\n    sheet.appendRow([obj.id, obj.tabName, obj.client, action, new Date().toISOString()]);\n  }\n\n  function ensureFolder(name) {\n    const it = DriveApp.getFoldersByName(name);\n    return it.hasNext() ? it.next() : DriveApp.createFolder(name);\n  }\n\n  return { store, restore, readRecords };\n})();" },
  { name: 'Cabinet', source: "/**\n * ============================================\n * Модуль: Cabinet\n * Ответственность: Временная страница кабинета клиента по токену объекта (до закрытия)\n * Зависимости: Objects, Records, Photos\n * ============================================\n */\n\nconst Cabinet = (() => {\n\n  /**\n   * HTML-страница кабинета клиента. Работает, пока объект не закрыт.\n   * @param {object} params — {object, key}\n   */\n  function page(params) {\n    const obj = Objects.byId(params.object);\n    if (!obj || obj.token !== String(params.key || '')) {\n      return html('<h1>Ссылка недействительна</h1><p>Попросите мастера прислать новую.</p>');\n    }\n    if (obj.status === 'закрыт') {\n      return html('<h1>Объект закрыт</h1><p>Работы завершены. Спасибо за сотрудничество!</p>');\n    }\n    const records = Records.list(obj.id);\n    const works = records.filter(r => r.type === 'РАСЧЁТ' && !r.flags.includes('удалено'));\n    const days = records.filter(r => r.type === 'ДЕНЬ');\n    const purchases = records.filter(r => r.type === 'ЗАКУПКА' && !r.flags.includes('удалено'));\n\n    const fmt = v => new Intl.NumberFormat('ru-RU').format(v) + ' ₽';\n    const worksSum = works.reduce((s, r) => s + r.sum, 0);\n    const purchasesSum = purchases.reduce((s, r) => s + r.sum, 0);\n    // Правило прайса №203: снабжение материалом — 10% от стоимости материалов, минимум 1500 ₽\n    const supply = purchasesSum > 0 ? Math.max(purchasesSum * 0.1, 1500) : 0;\n    const total = worksSum + purchasesSum + supply;\n\n    const photos = purchases\n      .flatMap(p => p.photoIds.split(',').filter(Boolean).map(id => Photos.url(id.trim())))\n      .map(url => `<a class=\"cabinet__photo\" href=\"${url}\" target=\"_blank\" rel=\"noopener\">\n        <img src=\"${url}\" alt=\"Накладная\" loading=\"lazy\">\n      </a>`).join('');\n\n    return html(`\n      <header class=\"cabinet__head\">\n        <h1>${esc(obj.name)}</h1>\n        <p class=\"cabinet__meta\">Заказчик: ${esc(obj.client || '—')} · Статус: ${esc(obj.status)}</p>\n      </header>\n      <section class=\"cabinet__block\">\n        <h2>Выполненные работы</h2>\n        <table class=\"cabinet__table\">\n          <thead><tr><th>Работа</th><th>Кол-во</th><th>Сумма</th></tr></thead>\n          <tbody>${works.map(r => `<tr><td>${esc(r.name)}</td><td>${r.qty} ${esc(r.unit)}</td><td>${fmt(r.sum)}</td></tr>`).join('')}</tbody>\n        </table>\n      </section>\n      <section class=\"cabinet__block\">\n        <h2>Материалы и закупки</h2>\n        <table class=\"cabinet__table\">\n          <thead><tr><th>Материал</th><th>Кол-во</th><th>Сумма</th></tr></thead>\n          <tbody>${purchases.map(r => `<tr><td>${esc(r.name)}</td><td>${r.qty}</td><td>${fmt(r.sum)}</td></tr>`).join('') || '<tr><td colspan=\"3\">Пока нет</td></tr>'}</tbody>\n        </table>\n      </section>\n      <section class=\"cabinet__block\">\n        <h2>Ход работ по дням</h2>\n        <ul class=\"cabinet__days\">${days.map(r =>\n          `<li><b>${esc(r.date.slice(0, 10))}</b> — ${esc(r.name)} <i>${esc(r.user)}, ${r.qty} ч</i></li>`).join('') || '<li>Записей пока нет</li>'}</ul>\n      </section>\n      ${photos ? `<section class=\"cabinet__block\"><h2>Фото накладных</h2><div class=\"cabinet__photos\">${photos}</div></section>` : ''}\n      <footer class=\"cabinet__total\">\n        <div>Работы: ${fmt(worksSum)}</div>\n        <div>Материалы: ${fmt(purchasesSum)}</div>\n        <div>Снабжение материалом (10%, мин. 1500 ₽): ${fmt(supply)}</div>\n        <div class=\"cabinet__total-main\">Итого: ${fmt(total)}</div>\n      </footer>\n    `);\n  }\n\n  function html(body) {\n    return HtmlService.createHtmlOutput(`<!DOCTYPE html>\n<html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Кабинет клиента — Братство Электриков</title>\n<style>\n  body { font-family: system-ui, sans-serif; margin: 0; background: #f4f6f8; color: #1e293b; }\n  .cabinet__head { background: #0f3d2e; color: #fff; padding: 24px 16px; }\n  .cabinet__head h1 { margin: 0 0 4px; font-size: 20px; }\n  .cabinet__meta { margin: 0; opacity: .85; font-size: 14px; }\n  .cabinet__block { background: #fff; margin: 12px; padding: 16px; border-radius: 12px; }\n  .cabinet__block h2 { margin: 0 0 12px; font-size: 16px; }\n  .cabinet__table { width: 100%; border-collapse: collapse; font-size: 14px; }\n  .cabinet__table th, .cabinet__table td { text-align: left; padding: 6px 4px; border-bottom: 1px solid #e2e8f0; }\n  .cabinet__days { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.7; }\n  .cabinet__photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }\n  .cabinet__photo img { width: 100%; border-radius: 8px; display: block; }\n  .cabinet__total { margin: 12px; padding: 16px; font-size: 15px; line-height: 1.8; }\n  .cabinet__total-main { font-weight: 700; font-size: 18px; }\n</style></head><body>${body}</body></html>`);\n  }\n\n  function esc(s) {\n    return String(s).replace(/[&<>\"']/g, c => ({\n      '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;',\n    }[c]));\n  }\n\n  return { page };\n})();" },
  { name: 'Router', source: "/**\n * ============================================\n * Модуль: Router\n * Ответственность: Маршрутизация GET/POST действий к модулям проекта\n * Зависимости: Users, Objects, Records, Prices, Photos, Visits, Archive\n * ============================================\n */\n\nconst Router = (() => {\n\n  function get(params) {\n    const action = String(params.action || '');\n    const user = Users.byToken(params.token);\n    switch (action) {\n      case 'bootstrap':\n        return bootstrap(user);\n      case 'login-options':\n        return { ok: true, users: Users.loginOptions() };\n      case 'prices':\n        return { ok: true, prices: Prices.all() };\n      case 'objects':\n        requireUser(user);\n        return { ok: true, objects: Objects.all(), lastRecordDates: Records.lastRecordDates() };\n      case 'object':\n        requireUser(user);\n        return { ok: true, object: Objects.byId(params.id), records: Records.list(params.id) };\n      case 'day-summary':\n        requireLeader(user);\n        return { ok: true, summary: Records.daySummary(params.date), visits: Visits.recent(50) };\n      case 'users':\n        requireLeader(user);\n        return { ok: true, users: Users.all() };\n      default:\n        throw new Error('Неизвестное действие: ' + action);\n    }\n  }\n\n  function post(body) {\n    const action = String(body.action || '');\n    const user = Users.byToken(body.token);\n    switch (action) {\n      case 'login':\n        return Users.login(body.login, body.code, body.device);\n      case 'logout':\n        return { ok: true };\n      case 'records:append':\n        requireUser(user);\n        return Records.appendBatch(body.objectId, body.items || []);\n      case 'photos:upload':\n        requireUser(user);\n        return Photos.upload(body.objectId, body.base64, body.mime);\n      case 'objects:create':\n        requireLeader(user);\n        return Objects.create(body.data || {});\n      case 'objects:update':\n        requireLeader(user);\n        return Objects.update(body.id, body.patch || {});\n      case 'objects:close':\n        requireLeader(user);\n        return Objects.close(body.id);\n      case 'objects:resume':\n        requireLeader(user);\n        return Objects.resume(body.id);\n      case 'users:save':\n        requireLeader(user);\n        return Users.save(user, body.data || {});\n      case 'status:report':\n        requireUser(user);\n        return Visits.reportStatus(user.login, body.pending, body.comment);\n      case 'status:queue-depth':\n        requireLeader(user);\n        return { ok: true, statuses: Visits.latestStatuses() };\n      default:\n        throw new Error('Неизвестное действие: ' + action);\n    }\n  }\n\n  function bootstrap(user) {\n    if (!user) return { ok: true, authorized: false };\n    return {\n      ok: true,\n      authorized: true,\n      user: { login: user.login, name: user.name, role: user.role },\n      prices: Prices.all(),\n      objects: Objects.all(),\n      lastRecordDates: Records.lastRecordDates(),\n    };\n  }\n\n  function requireUser(user) {\n    if (!user) throw new Error('Требуется вход');\n  }\n\n  function requireLeader(user) {\n    if (!user) throw new Error('Требуется вход');\n    if (user.role !== 'руководитель') throw new Error('Недостаточно прав');\n  }\n\n  return { get, post };\n})();" },
  { name: 'Bot', source: "/**\n * ============================================\n * Модуль: Bot\n * Ответственность: Telegram-бот: напоминания о неотправленном, незаписанном дне, закрытии объекта\n * Зависимости: Router, Records, Users\n * ============================================\n * ЭТАП 2: файл-заготовка. Активируется после получения токена от @BotFather:\n *   1) setWebhook() один раз: BotSetWebhook('https://script.google.com/macros/s/XXX/exec', token)\n *   2) триггер по расписанию:installReminders — напоминания в 20:00\n */\n\nconst BOT_TOKEN_PROPERTY = 'BOT_TOKEN';\n\nfunction botSendMessage(chatId, text) {\n  const token = PropertiesService.getScriptProperties().getProperty(BOT_TOKEN_PROPERTY);\n  if (!token) throw new Error('Токен бота не задан (свойства скрипта: BOT_TOKEN)');\n  UrlFetchApp.fetch('https://api.telegram.org/bot' + token + '/sendMessage', {\n    method: 'post',\n    contentType: 'application/json',\n    payload: JSON.stringify({ chat_id: chatId, text }),\n  });\n}\n\n/** Вебхук бота — связывание чата с логином (этап 2). */\nfunction botWebhook(update) {\n  // Здесь будет связь «чат ↔ логин» и команды /start, /status\n  return { ok: true };\n}\n\n/** Напоминания по расписанию (этап 2): незаписанный день, неотправленная очередь. */\nfunction botReminders() {\n  // Здесь будет обход Records.daySummary(сегодня) и Visits.latestStatuses()\n  // и отправка сообщений привязанным чатам\n}" },
  { name: 'Code', source: "/**\n * ============================================\n * Модуль: Code\n * Ответственность: Точка входа Web App: doGet/doPost и маршрутизация действий\n * Зависимости: Router, Cabinet\n * ============================================\n */\n\nfunction doGet(e) {\n  try {\n    const params = (e && e.parameter) || {};\n    if (params.page === 'cabinet') return Cabinet.page(params);\n    return json(Router.get(params));\n  } catch (err) {\n    return json({ ok: false, error: String(err) });\n  }\n}\n\nfunction doPost(e) {\n  try {\n    const body = JSON.parse((e && e.postData && e.postData.contents) || '{}');\n    return json(Router.post(body));\n  } catch (err) {\n    return json({ ok: false, error: String(err) });\n  }\n}\n\n/** JSON-ответ. text/plain обходит ограничение предзапроса CORS — PWA шлёт тот же тип. */\nfunction json(data) {\n  return ContentService.createTextOutput(JSON.stringify(data))\n    .setMimeType(ContentService.MimeType.JSON);\n}\n\n/** Меню в таблице: инициализация структуры и загрузка прайса. */\nfunction onOpen() {\n  SpreadsheetApp.getUi()\n    .createMenu('Братство Электриков')\n    .addItem('Инициализировать структуру', 'ensureStructure')\n    .addItem('Загрузить прайс из seed', 'seedPricesFromBackend')\n    .addToUi();\n}\n\n/** Заливка прайса из backend/seed/price.json — вставляется при деплое. */\nfunction seedPricesFromBackend() {\n  Sheets.ensureStructure();\n  Users.seedSlots();\n  const items = JSON.parse(SEED_PRICE_JSON);\n  const result = Prices.replace(items);\n  SpreadsheetApp.getActiveSpreadsheet().toast('Загружено позиций: ' + result.count);\n}" },
];

function installAll() {
  const scriptId = ScriptApp.getScriptId();
  const files = MODULES.map(m => ({ name: m.name, type: 'SERVER_JS', source: m.source }));
  try {
    Script.Projects.updateContent(scriptId, { files: files });
  } catch (e) {
    throw new Error(
      'Не удалось установить модули: ' + e +
      '. Проверь, что добавлен сервис Apps Script API (Сервисы → + → Apps Script API).'
    );
  }
  let count = files.length;
  try {
    count = Script.Projects.getContent(scriptId).files.length;
  } catch (e) { /* подсчёт не критичен */ }
  try {
    SpreadsheetApp.getActiveSpreadsheet().toast('Установлено модулей: ' + count + '. Обнови страницу редактора.');
  } catch (e) { /* не табличный скрипт — просто молчим */ }
  return count;
}
